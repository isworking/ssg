build --quiet
status 0
lacks a.log
has keep.log
lacks x/a.log
has x/keep.log
lacks build/out.txt
lacks x/build/out.txt
has build.txt
lacks root-only.txt
has x/root-only.txt
lacks docs/a.tmp
has docs/sub/a.tmp
has x/docs/a.tmp
lacks cache/c.txt
lacks x/cache/y/c.txt
has cachefile.txt
lacks a/z.txt
lacks a/b/c/z.txt
has b/a/z.txt
lacks '#hash.txt'
lacks '!bang.txt'
lacks trailing.txt
# a file can't be re-included when its directory is excluded
lacks private/allowed.txt
lacks art.psd
lacks x/art.psd
lacks from-config.txt
has x/from-config.txt
has kept.txt
lacks drafts/wip/index.html
has drafts/image.png
has page/index.html
# nested .assetignore: relative to its own dir, deeper files win
lacks nested/one.txt
has nested/deep/one.txt
has nested/sub/one.txt
has nested/two.txt
has nested/sub/three.txt
has three.txt
lacks .assetignore
lacks nested/.assetignore
