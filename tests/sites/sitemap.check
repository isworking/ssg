build --quiet
status 0
same sitemap.xml '<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://example.com/</loc><lastmod>2026-03-04</lastmod></url>
  <url><loc>https://example.com/a/</loc><lastmod>2026-03-05</lastmod></url>
  <url><loc>https://example.com/nodate/</loc></url>
</urlset>
'
echo custom >"$SITE/sitemap.xml"
build --quiet
status 0
err_has 'sitemap.xml exists in the content dir'
same sitemap.xml 'custom
'
